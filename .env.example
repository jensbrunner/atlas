# Copy to .env for local use. Never commit real credentials.
ATLAS_DATABASE_URL=sqlite:///./data/atlas.db
ATLAS_MODE=offline_test
ATLAS_ALLOW_CLOUD=false
ATLAS_MONTHLY_USD_LIMIT=10.00
ATLAS_SESSION_USD_LIMIT=2.00
ATLAS_REQUEST_TIMEOUT_SECONDS=35
ATLAS_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
ATLAS_LOCAL_MODEL=qwen3:8b
ATLAS_OPENAI_PARSER_MODEL=gpt-6-luna
ATLAS_OPENAI_NARRATOR_MODEL=gpt-6.1-sol
ATLAS_OPENAI_PREMIUM_MODEL=gpt-6-astra
ATLAS_DEEPSEEK_MODEL=deepseek-flash
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
