# Copy to .env for local use. Never commit real credentials.

# Offline default. The fake provider needs no key and makes no network calls.
ATLAS_PROVIDER=fake
ATLAS_DATA_DIR=./campaigns

# Live narration is opt-in. Uncomment all three lines and provide a key.
# ATLAS_PROVIDER=openai
# ATLAS_OPENAI_API_KEY=sk-...
# ATLAS_ALLOW_CLOUD=true

# Models are used as configured; ATLAS never silently substitutes another model.
ATLAS_CAMPAIGN_MODEL=gpt-6-luna
ATLAS_NARRATOR_MODEL=gpt-6-luna
ATLAS_WORLD_MODEL=gpt-6-luna
ATLAS_AUDITOR_MODEL=gpt-6-luna

# Budgets and loop limits.
ATLAS_TURN_TOKEN_LIMIT=12000
ATLAS_TURN_DEADLINE_SECONDS=180
ATLAS_MAX_TOOL_ITERATIONS=8
ATLAS_RECENT_TURN_LIMIT=6
ATLAS_CONTEXT_CHAR_BUDGET=48000
ATLAS_SESSION_USD_LIMIT=2.00
ATLAS_REQUEST_TIMEOUT_SECONDS=90
# Fallback prices for unknown/custom model IDs, in USD per million tokens.
# Known major models use the built-in list-price table.
ATLAS_INPUT_USD_PER_MILLION=0
ATLAS_OUTPUT_USD_PER_MILLION=0

# Local server.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
